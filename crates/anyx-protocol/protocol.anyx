## The schema language of the anyx protocol, in the grammar language.
## `src/grammar.rs` is generated from it; `tests/schema.rs` checks that it is
## up to date.

## A schema of one file has the `PROTOCOL` header first. A schema of a
## folder has it alone in `protocol.anyx`; every other file is a scope, and
## holds only definitions.
ENTRY [header: OPTIONAL: protocol, ZERO OR MORE: definition],

protocol: ANYFIX CALL [
  doc: OPTIONAL: STRING,
  WORD "PROTOCOL", name: type name,
  WORD "VERSION", version: NUMBER [INTEGER, AT LEAST 1, AT MOST 4294967295],
],

definition: ONE OF [record, choice, errors, method],

record: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "RECORD", body: record body],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "RECORD", body: record body],
],

record body: ANYFIX CALL [name: WORDS [NO KEYWORD], fields: CURLY BRACE [ZERO OR MORE: field]],

field: ANYFIX CALL [doc: OPTIONAL: STRING, name: WORDS [NO KEYWORD], type: field type],

field type: ONE OF [optional: ANYFIX CALL [WORD "OPTIONAL", type], type],

choice: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "CHOICE", body: choice body],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "CHOICE", body: choice body],
],

choice body: ANYFIX CALL [
  name: WORDS [NO KEYWORD],
  variants: CURLY BRACE [ONE OR MORE: variant],
],

## A variant is written in the shape it takes on the wire. Its doc comes
## first, so it fills the call's first slot.
variant: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: variant slot],

variant slot: ONE OF [doc: STRING, parameter],

## A group of errors that methods share: its name and its own errors, then
## other groups joined with `+`, as in
## `ERRORS export errors [unreadable (diagnostics: LIST diagnostic)] + file errors`.
## `PUBLIC` lets other scopes use a type or a group, by its full path.
errors: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "ERRORS", body: error list],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "ERRORS", body: error list],
],

method: ONE OF [
  value with errors: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", returns: returns,
    WORD "ERRORS", errors: error list,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "ERRORS"],
  value: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", returns: returns,
  ] FORMAT [BREAK BEFORE WORD "RETURNS"],
  nothing with errors: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", WORD "NOTHING",
    WORD "ERRORS", errors: error list,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "ERRORS"],
  nothing: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", WORD "NOTHING",
  ] FORMAT [BREAK BEFORE WORD "RETURNS"],
],

## A method that has nothing to return, such as `sign out`, says
## `RETURNS NOTHING`; a call of it that succeeds answers `RETURNS NOTHING`.

## What a method returns is named too: `RETURNS (new revision: INTEGER)`.
returns: parameter,

## A method's errors: its own in brackets, then groups joined with `+`:
## `[conflict at revision (revision: INTEGER)] + file errors`. Joined terms
## make one call, `_ + _`, and a group's full path, `files/file errors`,
## reads as `_/_` among them, so the schema checker reads the terms from the
## call's name: brackets, group names, and in a group's `ERRORS` its name
## before its own errors, the call `file errors _`.
error list: error term,

error term: ONE OF [
  own: SQUARE BRACKET [ONE OR MORE: error],
  call: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: error term],
],

## An error is written in its shape, like a variant, with its doc first.
error: variant,

shape: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: parameter],

parameter: ANYFIX CALL [name: WORDS [NO KEYWORD], type],

type: ONE OF [
  WORD "TEXT",
  WORD "BYTES",
  WORD "INTEGER",
  WORD "NUMBER",
  WORD "BOOLEAN",
  list: ANYFIX CALL [WORD "LIST", item: type],
  named: reference,
],

## A type by its name, `diagnostic`, or by its full path from
## another scope, `common/diagnostic`, which reads as the call `_/_` of
## `common` and `diagnostic`. The schema checker tells the two apart.
reference: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: type name],

type name: ANYFIX CALL [NAME [NO KEYWORD], NO ARGUMENTS],
