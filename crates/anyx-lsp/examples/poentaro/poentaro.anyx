## A `.poentaro` document, as an anyx grammar (see anyx's
## crates/anyx-generator/README.md). `just generate-parser` writes
## `generated.rs` from it.
##
## The grammar says which shapes are allowed. It lists every metadata, style
## and preset key with the value that key takes (a string, a positive
## integer, `yes` or `no`, a notation, a font family), so a mistyped key or
## value is the grammar's error, and an editor completes both. What other
## values mean, such as which instrument a word names, is checked in Rust.
## Lists people edit by hand use `EACH`, so that one mistake does not hide
## the rest.

## Sections may come in any order. A section's `keyword` and a part's or
## option's are where the highlighter colors them. A second metadata, parts, sequence or
## score section is kept as an error, and the first one is read.
ENTRY: ANY ORDER [
  unconverted: ZERO OR MORE: unconverted,
  metadata: OPTIONAL: ANYFIX CALL [keyword: WORD "metadata", fields: metadata record],
  parts: OPTIONAL: ANYFIX CALL [keyword: WORD "parts", parts: part list],
  sequence: OPTIONAL: ANYFIX CALL [keyword: WORD "sequence", entries: entry list],
  preset: ZERO OR MORE: ANYFIX CALL [keyword: WORD "preset", name: STRING, fields: preset record],
  score: OPTIONAL: ANYFIX CALL [keyword: WORD "score", text: STRING],
],

## Text the converter from the old syntax kept because it could not read it.
unconverted: ANYFIX CALL [WORDS "could not convert", text: STRING],

## ── fields ──────────────────────────────────────────────────────────────

## The keys a metadata section takes, each with the value it takes. A preset
## takes them too, besides its own.
metadata record: CURLY BRACE: EACH: metadata field,

metadata field: ONE OF [
  text: text field,
  style: text style,
  number: number field,
  flag: flag field,
  ## `(0, -4)`: how far the directives above a row move, in points.
  directive row offset: ANYFIX CALL [
    key: WORDS "directive row offset",
    offset: PARENTHESIS [x: signed integer, y: signed integer],
  ],
  ## Text the converter from the old syntax kept because it could not read it.
  could not convert: ANYFIX CALL [key: WORDS "could not convert", text: STRING],
],

## `title "Minuet in G"`.
text field: ONE OF [
  title: ANYFIX CALL [key: WORDS "title", text: STRING],
  subtitle: ANYFIX CALL [key: WORDS "subtitle", text: STRING],
  author: ANYFIX CALL [key: WORDS "author", text: STRING],
],

## `lyrics style { font size 14, bold : yes }`.
text style: ONE OF [
  title style: ANYFIX CALL [key: WORDS "title style", style: style record],
  subtitle style: ANYFIX CALL [key: WORDS "subtitle style", style: style record],
  author style: ANYFIX CALL [key: WORDS "author style", style: style record],
  sequence style: ANYFIX CALL [key: WORDS "sequence style", style: style record],
  part legend style: ANYFIX CALL [key: WORDS "part legend style", style: style record],
  measure number style: ANYFIX CALL [key: WORDS "measure number style", style: style record],
  section label style: ANYFIX CALL [key: WORDS "section label style", style: style record],
  part label style: ANYFIX CALL [key: WORDS "part label style", style: style record],
  page number style: ANYFIX CALL [key: WORDS "page number style", style: style record],
  running title style: ANYFIX CALL [key: WORDS "running title style", style: style record],
  lyrics style: ANYFIX CALL [key: WORDS "lyrics style", style: style record],
  notes style: ANYFIX CALL [key: WORDS "notes style", style: style record],
  chords style: ANYFIX CALL [key: WORDS "chords style", style: style record],
  note dash style: ANYFIX CALL [key: WORDS "note dash style", style: style record],
],

## `max measures per system 4`.
number field: ONE OF [
  row height: ANYFIX CALL [key: WORDS "row height", number: positive],
  max measures per system: ANYFIX CALL [key: WORDS "max measures per system", number: positive],
  note number width: ANYFIX CALL [key: WORDS "note number width", number: positive],
  parts list columns: ANYFIX CALL [key: WORDS "parts list columns", number: positive],
  part label width pt: ANYFIX CALL [key: WORDS "part label width pt", number: positive],
  page margin pt: ANYFIX CALL [key: WORDS "page margin pt", number: positive],
],

## `hide resting parts : yes`.
flag field: ONE OF [
  merge duplicate measures across parts: ANYFIX CALL [key: WORDS "merge duplicate measures across parts", flag],
  hide resting parts: ANYFIX CALL [key: WORDS "hide resting parts", flag],
  hide system dividers: ANYFIX CALL [key: WORDS "hide system dividers", flag],
],

positive: NUMBER [INTEGER, AT LEAST 1],

flag: ONE OF [WORDS "yes", WORDS "no"],

## A preset's own keys, and the metadata it overrides.
preset record: CURLY BRACE: EACH: preset field,

preset field: ONE OF [
  ## `[S, A1]`.
  visible parts: ANYFIX CALL [key: WORDS "visible parts", parts: part references],
  soloed parts: ANYFIX CALL [key: WORDS "soloed parts", parts: part references],
  notation: ANYFIX CALL [key: WORDS "notation", notation],
  metadata: metadata field,
],

part references: SQUARE BRACKET: EACH: abbreviation,

notation: ONE OF [
  WORDS "numbered",
  WORDS "violin",
  WORDS "cello",
  WORDS "abc",
  WORDS "guitar",
  WORDS "harmonica",
  ## What `numbered` was called before; still read, never written.
  WORDS "jianpu",
],

## A text style's `{ … }`.
style record: CURLY BRACE: EACH: style field,

style field: ONE OF [
  font size: ANYFIX CALL [key: WORDS "font size", size: positive],
  horizontal padding pt: ANYFIX CALL [key: WORDS "horizontal padding pt", points: NUMBER [INTEGER, AT LEAST 0]],
  vertical padding pt: ANYFIX CALL [key: WORDS "vertical padding pt", points: NUMBER [INTEGER, AT LEAST 0]],
  bold: ANYFIX CALL [key: WORDS "bold", flag],
  italic: ANYFIX CALL [key: WORDS "italic", flag],
  underline: ANYFIX CALL [key: WORDS "underline", flag],
  font family: ANYFIX CALL [key: WORDS "font family", family: font family],
],

font family: ONE OF [WORDS "serif", WORDS "sans serif", WORDS "monospace"],

## `4`, `-4`, `+ 4` or `- 4`.
signed integer: NUMBER [INTEGER, SIGNED],

## `80 %`.
percentage: ANYFIX CALL [number: NUMBER [INTEGER], WORD "%"],

## Words and nothing else: `yes`, `sans serif`, `Verse two`.
words: ANYFIX CALL [NO ARGUMENTS],

## ── parts ───────────────────────────────────────────────────────────────

part list: SQUARE BRACKET: EACH: part,

part: ONE OF [
  unconverted,
  abbreviated: ANYFIX CALL [
    display: STRING,
    abbreviation: SQUARE BRACKET: abbreviation,
    kind: part kind,
  ],
  named: ANYFIX CALL [display: STRING, kind: part kind],
],

part kind: ONE OF [
  notes: ANYFIX CALL [keyword: WORD "notes", OPTIONAL: options],
  chords: ANYFIX CALL [keyword: WORD "chords", OPTIONAL: options],
  percussion: ANYFIX CALL [keyword: WORD "percussion", OPTIONAL: options],
  follow: ANYFIX CALL [
    keyword: WORD "follow",
    target: SQUARE BRACKET: abbreviation,
    OPTIONAL: options,
  ],
  ## Options are read only so Rust can say a lyric part takes none.
  lyrics: ANYFIX CALL [
    keyword: WORD "lyrics",
    targets: SQUARE BRACKET: EACH: abbreviation,
    OPTIONAL: options,
  ],
],

options: CURLY BRACE: EACH: part option,

part option: ONE OF [
  instrument: ANYFIX CALL [keyword: WORD "instrument", name: words],
  ## `C3 to G4`, whose capitalised words split anyx's word runs, so Rust
  ## reads it from the node.
  range: ANYFIX CALL [keyword: WORD "range", value: ANY NODE],
  sound: ANYFIX CALL [keyword: WORD "sound", value: sound],
  volume: ANYFIX CALL [keyword: WORD "volume", percentage],
  octave: ANYFIX CALL [keyword: WORD "octave", signed integer],
],

## `41`, a General MIDI program, or `chimera soprano`, a singing voice.
sound: ONE OF [program: NUMBER [INTEGER], voice: words],

## A part's abbreviation: a string, or words, numbers and symbols that are
## joined without spaces (`A1 & T` is the call `A1 _ T` of the word `&`).
abbreviation: ONE OF [
  text: STRING,
  number: NUMBER,
  written: ANYFIX CALL,
],

## ── sequence ────────────────────────────────────────────────────────────

entry list: SQUARE BRACKET: EACH: sequence entry,

sequence entry: ONE OF [
  with without: ANYFIX CALL [
    label,
    WORD "WITH",
    lines: line choices,
    WORD "WITHOUT",
    parts: SQUARE BRACKET: EACH: abbreviation,
  ],
  with only: ANYFIX CALL [
    label,
    WORD "WITH",
    lines: line choices,
    WORD "ONLY",
    parts: SQUARE BRACKET: EACH: abbreviation,
  ],
  with: ANYFIX CALL [label, WORD "WITH", lines: line choices],
  without: ANYFIX CALL [label, WORD "WITHOUT", parts: SQUARE BRACKET: EACH: abbreviation],
  only: ANYFIX CALL [label, WORD "ONLY", parts: SQUARE BRACKET: EACH: abbreviation],
  label,
],

## `Verse`, `Verse two` or `"Last chorus"`.
label: ONE OF [text: STRING, words],

## `([w] 2, [a] 1)`, or a lone `[w] 2`.
line choices: ONE OF [many: PARENTHESIS: EACH: line choice, one: line choice],

## `[w] 2`: a part and the number of the line it plays.
line choice: ANYFIX CALL [part: SQUARE BRACKET: abbreviation, line: NUMBER [INTEGER]],
