# The corners of the generator: rules named like the types its output uses,
# every kind of number and word, fields named like Rust keywords, brackets
# with and without fields, recursion through an optional field, `EACH`
# among the parts of a call, a call with no arguments, and a node kept as
# it is.

ENTRY [header: OPTIONAL: string, ZERO OR MORE: node],

string: STRING [STARTS WITH "#", ENDS WITH "!", CONTAINS "a", MATCHING REGEX "^.{3,}$"],

node: ONE OF [
  option,
  numbers,
  words,
  box,
  vec: SQUARE BRACKET [ONE OR MORE: node],
  nothing: PARENTHESIS [],
  only words: PARENTHESIS [WORD "only", WORD "words"],
  wrapped: PARENTHESIS [WORD "wrap", OPTIONAL: node, WORD "end"],
  each: ANYFIX CALL [WORD "EACH", EACH: node],
  kept: ANYFIX CALL [WORD "KEEP", node: ANY NODE],
  raw: ANYFIX CALL [NAME [STARTS WITH "raw "]],
  exact: STRING "exact",
  spanned: span,
  WORD "type",
  WORD "NOT_NULL",
],

span: WORD "span",

option: ANYFIX CALL [
  WORD "OPTION", type: ANY WORD [SYMBOL], OPTIONAL: node,
  WORD "THEN", match: OPTIONAL: string, WORD "END",
],

numbers: SQUARE BRACKET [
  byte: NUMBER [INTEGER, AT LEAST 0, AT MOST 255],
  offset: NUMBER [INTEGER, AT LEAST -1000, AT MOST 1000],
  count: NUMBER [INTEGER, AT LEAST 0],
  whole: NUMBER [INTEGER],
  huge: NUMBER [INTEGER, AT MOST 1e30],
  ratio: NUMBER [AT LEAST 0, AT MOST 1],
  answer: NUMBER 42,
  signed: NUMBER [INTEGER, SIGNED, AT LEAST -10, AT MOST 10],
  rest: ZERO OR MORE: NUMBER,
],

words: ANYFIX CALL [
  WORD "WORDS",
  list: SQUARE BRACKET [
    keyword: ANY WORD [KEYWORD],
    name: ANY WORD [NAME, MATCHING REGEX "^[a-z]+$"],
    symbol: ANY WORD [SYMBOL],
    any: ANY WORD,
    phrase: ANYFIX CALL [NO ARGUMENTS],
    arrow: WORD "->",
    bars: ZERO OR MORE: WORD "|",
    WORD "end",
  ],
],

box: CURLY BRACE [inner: node, result: OPTIONAL: node],
