## JSON, as an anyx grammar.

ENTRY: value,

value: ONE OF [
  object,
  array,
  string: STRING,
  number: NUMBER,
  WORD "null",
  WORD "true",
  WORD "false",
],

object: CURLY BRACE: ZERO OR MORE: member,

## `"key": value` is the call `_ _` of the key and the value.
member: ANYFIX CALL [key: STRING, value],

array: SQUARE BRACKET: ZERO OR MORE: value,
