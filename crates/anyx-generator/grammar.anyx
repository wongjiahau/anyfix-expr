## The grammar of anyx grammars, written as one.

## A grammar is its entry, then its rules.
ENTRY [entry, ZERO OR MORE: rule],

entry: ANYFIX CALL [WORD "ENTRY", contents],

rule: named,

## `key value: pattern` defines a rule; inside a list, `key: pattern` names a
## field or a choice. A `#` line string just above it documents it, for the
## people who write the language: the line string is the call's first
## argument. A `##` comment is for whoever reads the grammar, and is dropped.
named: ONE OF [
  documented: ANYFIX CALL [
    documentation: STRING,
    name: WORDS [MATCHING REGEX "^[a-z][a-z0-9]*( [a-z][a-z0-9]*)*$"],
    pattern,
  ],
  plain: ANYFIX CALL [
    NAME [MATCHING REGEX "^[a-z][a-z0-9]*( [a-z][a-z0-9]*)* _$"],
    ARGUMENTS: pattern,
  ],
],

## What a container or the entry holds: one element, a list of them in order,
## or a list of them in any order.
contents: ONE OF [list: SQUARE BRACKET [ZERO OR MORE: element], any order, element],

any order: ANYFIX CALL [
  WORD "ANY", WORD "ORDER",
  elements: SQUARE BRACKET [ONE OR MORE: element],
],

element: ONE OF [field: named, pattern],

pattern: ONE OF [
  reference,
  one of,
  repetition,
  container,
  specific call,
  any call,
  word,
  any word,
  exact words,
  words,
  string,
  number,
  any node,
],

## A rule's name: lowercase words, no arguments.
reference: ANYFIX CALL [NAME [MATCHING REGEX "^[a-z][a-z0-9]*( [a-z][a-z0-9]*)*$"]],

one of: ANYFIX CALL [
  WORD "ONE", WORD "OF",
  choices: SQUARE BRACKET [ONE OR MORE: element],
],

repetition: ONE OF [
  zero or more: ANYFIX CALL [WORD "ZERO", WORD "OR", WORD "MORE", pattern],
  one or more: ANYFIX CALL [WORD "ONE", WORD "OR", WORD "MORE", pattern],
  optional: ANYFIX CALL [WORD "OPTIONAL", pattern],
  each: ANYFIX CALL [WORD "EACH", pattern],
],

container: ONE OF [
  curly brace: ANYFIX CALL [WORD "CURLY", WORD "BRACE", contents],
  square bracket: ANYFIX CALL [WORD "SQUARE", WORD "BRACKET", contents],
  parenthesis: ANYFIX CALL [WORD "PARENTHESIS", contents],
],

## Words in the list name the call; every other element fills a slot.
## `FORMAT` says how the formatter lays the call out.
specific call: ONE OF [
  formatted: ANYFIX CALL [
    WORD "ANYFIX", WORD "CALL",
    parts: SQUARE BRACKET [ONE OR MORE: element],
    WORD "FORMAT",
    format: SQUARE BRACKET [ONE OR MORE: format rule],
  ],
  plain: ANYFIX CALL [
    WORD "ANYFIX", WORD "CALL",
    parts: SQUARE BRACKET [ONE OR MORE: element],
  ],
],

## `BREAK BEFORE WORD "RETURNS"`: when the call is too long for its line,
## `RETURNS` starts a new one, indented.
format rule: break before,

break before: ANYFIX CALL [WORD "BREAK", WORD "BEFORE", WORD "WORD", text: STRING],

any call: ANYFIX CALL [
  WORD "ANYFIX", WORD "CALL",
  conditions: OPTIONAL: SQUARE BRACKET [ONE OR MORE: call condition],
],

call condition: ONE OF [
  name: ANYFIX CALL [
    WORD "NAME",
    conditions: SQUARE BRACKET [ONE OR MORE: name condition],
  ],
  arguments: ANYFIX CALL [WORD "ARGUMENTS", pattern],
  no arguments: ANYFIX CALL [WORD "NO", WORD "ARGUMENTS"],
],

## A condition on a call's name, or on the words `WORDS` takes.
name condition: ONE OF [no keyword: ANYFIX CALL [WORD "NO", WORD "KEYWORD"], string condition],

word: ANYFIX CALL [WORD "WORD", text: STRING],

## `WORDS "max measures per system"`: those words, written as one string.
## It matches them in a row, as one `WORD` per word would, but as one part:
## a mismatch expects all of them, and a name gives their span.
exact words: ANYFIX CALL [WORD "WORDS", text: STRING],

## Among the parts of a call: one or more of its name words in a row.
words: ANYFIX CALL [
  WORD "WORDS",
  conditions: OPTIONAL: SQUARE BRACKET [ONE OR MORE: name condition],
],

## Any one node, kept as it is for the caller to decode.
any node: ANYFIX CALL [WORD "ANY", WORD "NODE"],

any word: ANYFIX CALL [
  WORD "ANY", WORD "WORD",
  conditions: OPTIONAL: SQUARE BRACKET [ONE OR MORE: word condition],
],

word condition: ONE OF [WORD "KEYWORD", WORD "NAME", WORD "SYMBOL", string condition],

string: ONE OF [
  any: WORD "STRING",
  exact: ANYFIX CALL [WORD "STRING", text: STRING],
  conditions: ANYFIX CALL [
    WORD "STRING",
    conditions: SQUARE BRACKET [ONE OR MORE: string condition],
  ],
],

string condition: ONE OF [
  starts with: ANYFIX CALL [WORD "STARTS", WORD "WITH", text: STRING],
  ends with: ANYFIX CALL [WORD "ENDS", WORD "WITH", text: STRING],
  contains: ANYFIX CALL [WORD "CONTAINS", text: STRING],
  matching regex: ANYFIX CALL [WORD "MATCHING", WORD "REGEX", regex: STRING],
],

number: ONE OF [
  any: WORD "NUMBER",
  exact: ANYFIX CALL [WORD "NUMBER", value: NUMBER],
  conditions: ANYFIX CALL [
    WORD "NUMBER",
    conditions: SQUARE BRACKET [ONE OR MORE: number condition],
  ],
],

number condition: ONE OF [
  WORD "INTEGER",
  ## Also `+ 4` and `- 4`, a sign written apart from its number.
  WORD "SIGNED",
  at least: ANYFIX CALL [WORD "AT", WORD "LEAST", bound: NUMBER],
  at most: ANYFIX CALL [WORD "AT", WORD "MOST", bound: NUMBER],
],
